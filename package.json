{
  "name": "mosquito-ui",
  "private": true,
  "version": "0.11.0",
  "description": "面向 uni-app 的轻量组件库 @mosquito/ui。运行时性能优先，并为 uni-app x 预留双文件结构。",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "pnpm --filter @mosquito/ui typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:utils": "vitest run packages/ui/test",
    "test:component": "COMPONENT_TEST=true vitest run tests/components",
    "coverage": "vitest run --coverage",
    "sync:easycom": "node scripts/sync-easycom.mjs",
    "sync:exports": "node scripts/sync-exports.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint --ext .ts,.vue,.js .",
    "lint:fix": "eslint --fix --ext .ts,.vue,.js .",
    "format": "prettier --write \"**/*.{ts,vue,js,json,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,js,json,scss,md}\"",
    "prepare": "husky install || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^8.0.3",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.14",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^9.4.3"
  },
  "lint-staged": {
    "*.{ts,vue,js}": "eslint --fix",
    "*.{ts,vue,js,json,scss,md}": "prettier --write"
  }
}
