{
  "name": "@mosquito/ui",
  "version": "0.2.0",
  "description": "面向 uni-app 的轻量组件库，运行时性能优先。",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": "./src/styles/index.scss",
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": [
    "**/*.scss",
    "**/*.css",
    "**/*.vue",
    "**/*.uvue"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mosquito1123/mosquito-ui.git",
    "directory": "packages/ui"
  },
  "license": "MIT",
  "keywords": [
    "uni-app",
    "uni-app-x",
    "vue3",
    "mosquito",
    "ui"
  ],
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "typescript": "^5.6.3",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.vue.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  }
}
